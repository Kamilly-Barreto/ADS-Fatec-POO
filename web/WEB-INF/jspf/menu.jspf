<%-- any content can be specified here e.g.: --%>
<%@ page pageEncoding="UTF-8" %>
<h2>Juros Simples</h2>
<form action="./juros-simples.jsp" method="post">
    Capital inicial: <input type="text" name="capital_simples"> <br>
    Taxa de juros: <input type="text" name="taxa_juro_simples">% <br>
    Tempo em meses: <input type="text" name="tempo_simples"> <br>
    <input type="submit" value="Calcular">
</form>
<br>
<form action="./juros-compostos.jsp" method="post">
    Capital inicial: <input type="text" name="capital_composto"> <br>
    Taxa de juros: <input type="text" name="taxa_juro_composto">% <br>
    Tempo em meses: <input type="text" name="tempo_composto"> <br>
    <input type="submit" value="Calcular">
</form>
